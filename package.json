{
  "name": "karkata-demo",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite --config web/vite.config.ts",
    "dev:server": "tsx watch server/src/index.ts",
    "build": "npm run build:web && npm run build:server",
    "build:web": "tsc -p web/tsconfig.json && vite build --config web/vite.config.ts",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc -p web/tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run server/src web/src"
  },
  "dependencies": {
    "@fastify/cookie": "^10.0.1",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/static": "^8.3.0",
    "@karkata-ai/core": "^0.1.1",
    "@karkata-ai/openai-compatible": "^0.1.1",
    "@karkata-ai/ui": "^0.1.1",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.2.1",
    "lucide-react": "^0.469.0",
    "phaser": "^3.90.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.10"
  }
}
